{
  "items": [
    {
      "name": "First install + import + protect + reboot",
      "action": "sh /mnt/us/extensions/kindle-native-sync/bootstrap.sh setup-fresh"
    },
    {
      "name": "Setup stopped preview + import + reboot",
      "action": "sh /mnt/us/extensions/kindle-native-sync/bootstrap.sh setup-preview"
    },
    {
      "name": "Resume imported setup + protect + reboot",
      "action": "sh /mnt/us/extensions/kindle-native-sync/bootstrap.sh resume-setup"
    },
    {
      "name": "Check protected reboot + export status",
      "action": "sh /mnt/us/extensions/kindle-native-sync/bootstrap.sh verify-setup"
    },
    {
      "name": "TLS check + authorize + prepare trial",
      "action": "sh /mnt/us/extensions/kindle-native-sync/bootstrap.sh authorize-prepare"
    },
    {
      "name": "Confirm approved trial + enable if verified",
      "action": "sh /mnt/us/extensions/kindle-native-sync/bootstrap.sh confirm-enable"
    },
    {
      "name": "Run installed online TLS check",
      "action": "sh /mnt/us/extensions/kindle-native-sync/bootstrap.sh online-self-test"
    },
    {
      "name": "Authorize experimental trial",
      "action": "sh /mnt/us/extensions/kindle-native-sync/bootstrap.sh authorize-trial"
    },
    {
      "name": "Prepare requested real session",
      "action": "sh /mnt/us/extensions/kindle-native-sync/bootstrap.sh prepare"
    },
    {
      "name": "Confirm the approved trial plan",
      "action": "sh /mnt/us/extensions/kindle-native-sync/bootstrap.sh confirm"
    },
    {
      "name": "Enable verified experimental autosync",
      "action": "sh /mnt/us/extensions/kindle-native-sync/bootstrap.sh enable-experimental"
    },
    {
      "name": "Disable experimental uploads",
      "action": "sh /mnt/us/extensions/kindle-native-sync/bootstrap.sh disable-experimental"
    },
    {
      "name": "Export root compatibility probe",
      "action": "sh /mnt/us/extensions/kindle-native-sync/bootstrap.sh probe"
    },
    {
      "name": "Run local candidate self-test (no network)",
      "action": "sh /mnt/us/extensions/kindle-native-sync/bootstrap.sh self-test"
    },
    {
      "name": "Install / upgrade (collection only)",
      "action": "sh /mnt/us/extensions/kindle-native-sync/bootstrap.sh install"
    },
    {
      "name": "Enable collection",
      "action": "sh /var/local/kindle-native-sync/install/control.sh enable"
    },
    {
      "name": "Disable collection",
      "action": "sh /var/local/kindle-native-sync/install/control.sh disable"
    },
    {
      "name": "Status",
      "action": "sh /var/local/kindle-native-sync/install/control.sh status"
    },
    {
      "name": "Import USB configuration",
      "action": "sh /var/local/kindle-native-sync/install/control.sh import-config"
    },
    {
      "name": "Export sanitized status",
      "action": "sh /var/local/kindle-native-sync/install/control.sh export"
    },
    {
      "name": "Uninstall (keep ledger)",
      "action": "sh /var/local/kindle-native-sync/install/control.sh uninstall"
    },
    {
      "name": "Recover interrupted preview (keep disabled)",
      "action": "sh /mnt/us/extensions/kindle-native-sync/bootstrap.sh preview-recover"
    }
  ]
}
